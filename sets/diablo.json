 "notes": [
  "Works with any copy of Diablo: Battle.net, GOG, the original CD, and DevilutionX. Hellfire too.",
  "Vault reads your save files and never touches the game. Single-player progress counts when the game saves: use Save Game in the menu, and achievements pop up then.",
  "Multiplayer heroes save all the time, so their achievements pop almost straight away.",
  "Kills and quests come from the saved game, so they're counted per hero and added up across all your heroes."
 ],
 "testGuide": [
  {
   "title": "Start a hero",
   "detail": "Make a new character and walk down the cathedral stairs to dungeon level 1."
  },
  {
   "title": "Kill a few monsters, then save",
   "detail": "Press Esc → Save Game. \"Into the Cathedral\" and \"Bloodied\" progress should show here within a few seconds."
  },
  {
   "title": "Check the numbers",
   "detail": "\"Last saved hero\" should show your name, level and class. If it says no saves were found, send a test report so I can see where your copy keeps them."
  }
 ],
