 "notes": [
  "Vault reads your save files (DATA\\SAVEGAME) and never touches the game. Achievements pop when you save.",
  "Quests count as done when the Pip-Boy crosses them off.",
  "Every save slot counts, so old saves you already have unlock what they show."
 ],
 "testGuide": [
  {
   "title": "Leave the Vault and save",
   "detail": "Start a game, walk out of Vault 13 and save in any slot. \"Out of the Vault\" should pop up."
  },
  {
   "title": "Check the numbers",
   "detail": "\"Last saved\" should show your character's name and \"Days in the wasteland\" the in-game day."
  }
