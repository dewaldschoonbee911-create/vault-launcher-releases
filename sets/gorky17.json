  "notes": [
    "Vault reads your save games (the SaveGame folder) and never touches the game.",
    "Save in each new place you reach and its achievement counts. Old saves count too."
  ],
  "testGuide": [
    {
      "title": "Start a new game and save",
      "detail": "Play until you can save at the port, then save. \"Welcome to Slupsk\" should pop."
    },
    {
      "title": "Check the numbers",
      "detail": "\"Last save\" should name the place you saved in."
    }
